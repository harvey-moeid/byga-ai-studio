{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byga-ai-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
