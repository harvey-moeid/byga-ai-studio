{
  "name": "byga-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified workspace for AI-assisted audio and video production",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.0.0", "npm": ">=10.0.0" },
  "scripts": {
    "dev": "npm run dev --workspace=@byga/web",
    "dev:api": "npm run dev --workspace=@byga/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspace=@byga/web && npm run build --workspace=@byga/api",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  }
}
